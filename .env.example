POSTGRES_USER=radio_user
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=radio_db

ICECAST_SOURCE_PASSWORD=troque-esta-senha
ICECAST_ADMIN_PASSWORD=troque-esta-senha
ICECAST_RELAY_PASSWORD=troque-esta-senha
ICECAST_MOUNT=/live.mp3

PUBLIC_API_URL=http://localhost:3001/api
PUBLIC_STREAM_URL=http://localhost:8000/live.mp3

# --- Painel administrativo ---
ADMIN_USER=admin
# Mínimo 10 caracteres
ADMIN_PASSWORD=troque-esta-senha
# Mínimo 32 caracteres aleatórios. Trocar derruba todas as sessões abertas.
SESSION_SECRET=gere-um-valor-aleatorio-com-pelo-menos-32-caracteres
# Endereço do site que usa o painel. Em produção: https://seudominio.com.br
CORS_ORIGINS=http://localhost:3000
# true quando o site estiver em HTTPS
COOKIE_SECURE=false
# 1 quando houver um proxy (Caddy) na frente da API
TRUST_PROXY=0

# --- Auto-DJ ---
# Senha entre o Liquidsoap e a API. Mínimo 16 caracteres aleatórios.
AUTODJ_TOKEN=gere-um-valor-aleatorio
# Fuso usado para saber qual programa da grade está no ar
RADIO_TIMEZONE=America/Sao_Paulo
# Intervalo mínimo entre vinhetas (minutos)
# Vinheta a cada 5 a 7 músicas (sorteado a cada vez)
JINGLE_EVERY_SONGS_MIN=5
JINGLE_EVERY_SONGS_MAX=7
# Uma música pedida não volta a tocar antes disso (minutos)
REQUEST_COOLDOWN_MIN=60
# Máximo de pedidos na fila ao mesmo tempo
MAX_QUEUED_REQUESTS=5
